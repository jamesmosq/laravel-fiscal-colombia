{
    "name": "jamesmosquera/moonshine-colombia-fiscal",
    "description": "Validador NIT, retenciones y campos fiscales colombianos para Laravel",
    "type": "library",
    "keywords": [
        "moonshine",
        "moonshine-plugin",
        "laravel",
        "colombia",
        "fiscal",
        "nit",
        "tributario",
        "dian",
        "retenciones"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "James Mosquera Rentería",
            "email": "jamesmosqr@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "moonshine/moonshine": "^4.14",
        "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^10.0|^11.0|^12.0"
    },
    "suggest": {
        "moonshine/moonshine": "Requerido para usar NitField y TipoDocumentoField en MoonShine"
    },
    "autoload": {
        "psr-4": {
            "JamesMosquera\\FiscalColombia\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "JamesMosquera\\FiscalColombia\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "JamesMosquera\\FiscalColombia\\FiscalColombiaServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
